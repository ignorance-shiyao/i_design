{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@i-design/common": [
        "packages/common/src/index.ts"
      ],
      "@i-design/common/*": [
        "packages/common/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "packages/*/src/**/*.ts",
    "vite.config.ts"
  ],
  "//": "Vue 2 包用的是另一套框架类型（vue@2.7），由它自己的构建校验；混进 Vue 3 的 vue-tsc 只会误报",
  "exclude": [
    "packages/vue/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/dist-demo/**"
  ]
}