<view class="i-sunburst" wx:if="{{model}}">
  <view class="i-sunburst__title">{{title}}</view>
  <view class="i-sunburst__caption">{{model.caption}}</view>
  <view wx:if="{{model.state === 'ready'}}">
    <view wx:if="{{focusId}}" class="i-sunburst__crumb">
      <button class="i-sunburst__up" data-id="" bindtap="focus">返回全部</button>
      <text>当前只看：{{focusLabel}}</text>
    </view>
    <view class="i-sunburst__palette" aria-hidden="true" />
    <view wx:for="{{[0,1,2,3,4,5,6,7]}}" wx:key="*this" class="i-sunburst__swatch i-sunburst__swatch--{{item}}" aria-hidden="true" />
    <canvas class="i-sunburst__plot" type="2d" style="width:{{size}}px;height:{{size}}px" aria-label="{{title}}，数据见下方层级列表" />
    <view class="i-sunburst__caption">内圈是上级，外圈是它的下级；同一支各层同色。占比同时给出占全体与占上级两种分母。</view>
  </view>
  <view class="i-sunburst__data">
    <button wx:for="{{rows}}" wx:key="id" class="i-sunburst__row {{selectedId === item.id ? 'is-selected' : ''}}" style="margin-left:{{item.depth * 16}}px" data-id="{{item.id}}" bindtap="select" aria-label="{{item.description}}{{selectedId === item.id ? '，已选' : ''}}">
      <text>{{item.label}}{{selectedId === item.id ? ' · 已选' : ''}}</text>
      <text class="i-sunburst__values">{{item.valueText}} · 占全体 {{item.shareText}}{{item.parentText}} · 源行 {{item.sourceIndex + 1}}</text>
    </button>
  </view>
  <view class="i-sunburst__issues" wx:if="{{model.excluded.length}}"><view wx:for="{{model.excluded}}" wx:key="id">源行 {{item.sourceIndex + 1}} · {{item.label}}：{{item.reason}}</view></view>
</view>
