<view class="i-popconfirm">
  <view class="i-popconfirm__trigger" bindtap="onToggle">
    <slot />
  </view>

  <view
    wx:if="{{visible}}"
    class="i-popconfirm__panel is-{{actual}}"
    style="left:{{left}}px;top:{{top}}px"
  >
    <view
      class="i-popconfirm__arrow"
      style="{{actual === 'top' || actual === 'bottom' ? 'left:' : 'top:'}}{{arrow}}px"
    />
    <view class="i-popconfirm__head">
      <view
        class="i-popconfirm__icon i-icon i-icon--{{theme === 'danger' ? 'warning-triangle' : 'help-circle'}}"
        style="width:16px;height:16px"
      />
      <text class="i-popconfirm__title">{{title}}</text>
    </view>
    <view wx:if="{{content}}" class="i-popconfirm__content">{{content}}</view>
    <view class="i-popconfirm__foot">
      <view class="i-button i-button--text i-button--sm" bindtap="onCancel">{{cancelLabel}}</view>
      <view
        class="i-button i-button--{{theme === 'danger' ? 'danger' : 'primary'}} i-button--sm"
        bindtap="onConfirm"
      >{{confirmLabel}}</view>
    </view>
  </view>
</view>
