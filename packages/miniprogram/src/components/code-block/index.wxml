<view class="i-code {{isDiff ? 'is-diff' : ''}}">
  <view class="i-code__bar">
    <text class="i-code__name">{{label}}</text>
    <view wx:if="{{isDiff}}" class="i-code__stat">
      <text class="i-code__stat-add">+{{added}}</text>
      <text class="i-code__stat-remove">−{{removed}}</text>
    </view>
    <view wx:if="{{copyable}}" class="i-code__copy" bindtap="copy">
      <view class="i-icon i-icon--copy" style="width:13px;height:13px" />
      <text>{{copyText}}</text>
    </view>
  </view>

  <scroll-view class="i-code__body" scroll-x scroll-y>
    <view wx:for="{{rows}}" wx:key="key" class="i-code__line i-code__line--{{item.kind}}">
      <text wx:if="{{lineNumbers}}" class="i-code__no">{{item.before}}</text>
      <text wx:if="{{lineNumbers && isDiff}}" class="i-code__no">{{item.after}}</text>
      <text wx:if="{{isDiff}}" class="i-code__sign">{{item.sign}}</text>
      <text
        wx:for="{{item.tokens}}"
        wx:for-item="tok"
        wx:key="index"
        class="i-code__tok i-code__tok--{{tok.type}}"
      >{{tok.text}}</text>
    </view>
  </scroll-view>
</view>
