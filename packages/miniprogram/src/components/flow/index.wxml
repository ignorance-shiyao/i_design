<view class="i-flow" style="height:{{height}}px">
  <canvas
    class="i-flow__canvas"
    type="2d"
    style="width:100%;height:{{height}}px"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtap="onMinimapTap"
  />
  <view class="i-flow__toolbar">
    <view
      wx:if="{{!readonly}}"
      class="i-flow__tool {{marqueeMode ? 'is-on' : ''}}"
      bindtap="toggleMarquee"
    >
      <view class="i-icon i-icon--marquee" style="width:14px;height:14px" />
    </view>
    <view
      wx:if="{{!readonly}}"
      class="i-flow__tool {{selection.length < 2 ? 'is-disabled' : ''}}"
      bindtap="groupSelection"
    >
      <view class="i-icon i-icon--folder" style="width:14px;height:14px" />
    </view>
    <view wx:if="{{!readonly}}" class="i-flow__tool" bindtap="layout">
      <view class="i-icon i-icon--layers" style="width:14px;height:14px" />
    </view>
    <view class="i-flow__tool {{showMinimap ? 'is-on' : ''}}" bindtap="toggleMinimap">
      <view class="i-icon i-icon--minimap" style="width:14px;height:14px" />
    </view>
    <view class="i-flow__tool" bindtap="exportImage">
      <view class="i-icon i-icon--download" style="width:14px;height:14px" />
    </view>
    <view class="i-flow__tool" bindtap="zoom" data-delta="-0.2">
      <view class="i-icon i-icon--minus" style="width:14px;height:14px" />
    </view>
    <text class="i-flow__zoom">{{scaleText}}</text>
    <view class="i-flow__tool" bindtap="zoom" data-delta="0.2">
      <view class="i-icon i-icon--plus" style="width:14px;height:14px" />
    </view>
    <view class="i-flow__tool" bindtap="fit">
      <view class="i-icon i-icon--grid" style="width:14px;height:14px" />
    </view>
  </view>
</view>
