<view class="i-chart i-chart--treemap">
  <view wx:if="{{title}}" class="i-chart__title">{{title}}</view>
  <canvas class="i-chart__treemap-canvas" type="2d" style="width:100%;height:{{height}}px" />

  <view class="i-chart__table i-chart__table--flat">
    <view class="i-chart__table-row i-chart__table-head">
      <text class="i-chart__table-cell">项目</text>
      <text class="i-chart__table-cell">数值</text>
      <text class="i-chart__table-cell">占比</text>
    </view>
    <view wx:for="{{rows}}" wx:key="label" class="i-chart__table-row">
      <text class="i-chart__table-cell">{{item.label}}</text>
      <text class="i-chart__table-cell">{{item.value}}</text>
      <text class="i-chart__table-cell">{{item.percent}}</text>
    </view>
  </view>
</view>
