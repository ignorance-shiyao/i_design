<scroll-view
  class="i-table-wrap {{height ? 'is-scrollable' : ''}}"
  style="{{height ? 'height:' + height + 'px' : ''}}"
  scroll-x
  scroll-y="{{!!height}}"
  bindscroll="onScroll"
>
  <view class="i-table-c i-table-c--{{size}} {{striped ? 'is-striped' : ''}}">
    <view class="i-table-c__head">
      <view
        wx:for="{{columns}}"
        wx:key="key"
        class="i-table-c__cell i-table-c__th {{item.sortable ? 'is-sortable' : ''}}"
        style="{{item.width ? 'width:' + item.width + ';' : 'flex:1;'}}text-align:{{item.align || 'left'}}"
        bindtap="onSort"
        data-key="{{item.key}}"
        data-sortable="{{item.sortable}}"
      >
        <text>{{item.title}}</text>
        <view wx:if="{{item.sortable}}" class="i-table-c__sorter">
          <view class="i-table-c__arrow is-up {{sortKey === item.key && sortOrder === 'asc' ? 'is-on' : ''}}" />
          <view class="i-table-c__arrow is-down {{sortKey === item.key && sortOrder === 'desc' ? 'is-on' : ''}}" />
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="i-table-c__state">{{loadingLabel}}</view>
    <view wx:elif="{{total === 0}}" class="i-table-c__state">{{emptyLabel}}</view>
    <!-- 上下两块空白替代没渲染的那些行，滚动条长度才和真实行数相称 -->
    <view wx:elif="{{virtual}}" class="i-table-c__spacer" style="height:{{paddingTop}}px" />
    <view
      wx:if="{{!loading && total > 0}}"
      class="i-table-c__row"
      wx:for="{{visible}}"
      wx:key="_key"
      wx:for-item="row"
    >
      <view
        wx:for="{{columns}}"
        wx:key="key"
        wx:for-item="col"
        class="i-table-c__cell"
        style="{{col.width ? 'width:' + col.width + ';' : 'flex:1;'}}text-align:{{col.align || 'left'}}"
      >{{row[col.key]}}</view>
    </view>
    <view wx:if="{{virtual}}" class="i-table-c__spacer" style="height:{{paddingBottom}}px" />
  </view>
</scroll-view>
