{
  "name": "@i-design/common",
  "version": "0.1.0",
  "description": "Ignorance Design 跨端公共层：设计令牌、图标数据与框架无关的交互逻辑",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json",
    "./styles/index.css": "./dist/styles/index.css",
    "./styles/mobile.css": "./dist/styles/mobile.css",
    "./tokens.css": "./dist/styles/index.css",
    "./tokens/*": "./dist/tokens/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.mjs"
  },
  "license": "MIT"
}
